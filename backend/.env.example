# ColdPilot backend environment template (non-secret defaults).
# Copy to .env and adjust. .env is git-ignored.

# --- Runtime ---
# SQLite URL relative to the backend working directory.
DATABASE_URL=sqlite+aiosqlite:///./data/coldpilot.db
# Comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Agent ---
# deterministic (default): runs fully offline with no external API.
# llm: requires LLM_BASE_URL / LLM_API_KEY / LLM_MODEL.
AGENT_MODE=deterministic
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_STALE_RUNNING_TIMEOUT_SECONDS=120
